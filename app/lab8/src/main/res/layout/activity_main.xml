<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Secțiune Inserare (Metoda 1) -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_name" />

            <EditText
                android:id="@+id/etType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_type" />

            <EditText
                android:id="@+id/etBooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_books"
                android:inputType="number" />

            <Button
                android:id="@+id/btnInsert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_insert" />

            <Button
                android:id="@+id/btnLoadAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_show_all" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC" android:layout_marginVertical="8dp"/>

            <!-- Căutare după Nume (Metoda 3) -->
            <EditText
                android:id="@+id/etSearchName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_search_name" />

            <Button
                android:id="@+id/btnSearchByName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_search_name" />

            <!-- Filtrare Interval (Metoda 4) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/etMinBooks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_min_books"
                    android:inputType="number" />
                <EditText
                    android:id="@+id/etMaxBooks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_max_books"
                    android:inputType="number" />
            </LinearLayout>

            <Button
                android:id="@+id/btnInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_interval" />

            <!-- Ștergere (Metoda 5) -->
            <EditText
                android:id="@+id/etDeleteValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_delete_value"
                android:inputType="number" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnDeleteGreater"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_delete_greater" />
                <Button
                    android:id="@+id/btnDeleteLess"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_delete_less" />
            </LinearLayout>

            <!-- Update (Metoda 6) -->
            <EditText
                android:id="@+id/etLetter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_letter"
                android:maxLength="1" />

            <Button
                android:id="@+id/btnIncrement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_increment" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rezultate (Metoda 2):"
        android:textStyle="bold"
        android:paddingTop="8dp"/>

    <ListView
        android:id="@+id/listViewStores"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>