<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/navy_primary">

    <include layout="@layout/toolbar_main" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/app_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:color/transparent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/navy_primary"
            android:layout_marginBottom="24dp"
            android:shadowColor="#40000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_default_sort"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:layout_marginBottom="4dp"/>
        <Spinner
            android:id="@+id/spDefaultSort"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_card_academic"
            android:entries="@array/sort_array"
            android:layout_marginBottom="24dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAutoSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_auto_save"
            android:textColor="@color/text_body"
            android:layout_marginBottom="12dp"/>

        <CheckBox
            android:id="@+id/cbRecentOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_recent_only"
            android:textColor="@color/text_body"
            android:layout_marginBottom="12dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_dark_mode"
            android:textColor="@color/text_body"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/btn_save_settings"
            android:background="@drawable/btn_academic_primary"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>
    </ScrollView>
</LinearLayout>
