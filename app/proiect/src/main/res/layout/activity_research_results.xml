<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/navy_primary">

    <include layout="@layout/toolbar_main" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/app_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:color/transparent">

        <EditText
            android:id="@+id/etSearchPaper"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/search_hint"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_card_academic"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Spinner
                android:id="@+id/spSource"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_academic"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/spSort"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_academic" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnDateFilter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/label_date"
                android:textSize="12sp"
                android:background="@drawable/bg_badge_navy"
                android:textColor="@color/navy_primary"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnClearFilters"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_clear_filters"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_gold"
                android:textColor="@color/gold_accent"
                style="?android:attr/borderlessButtonStyle" />

            <CheckBox
                android:id="@+id/cbFavoritesOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_favorites"
                android:textSize="13sp"
                android:textColor="@color/text_body"
                android:shadowColor="#40000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:layout_marginStart="16dp" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <!-- Success State -->
        <ListView
            android:id="@+id/lvPapers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"/>

        <!-- Loading State -->
        <LinearLayout
            android:id="@+id/llLoadingResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/gold_accent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading_msg"
                android:textColor="@color/text_body"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/llEmptyResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:padding="32dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_search_category_default"
                app:tint="@color/text_muted"
                android:contentDescription="@string/search_hint"
                android:alpha="0.4"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_results_msg"
                android:textAlignment="center"
                android:textColor="@color/text_muted"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
</LinearLayout>