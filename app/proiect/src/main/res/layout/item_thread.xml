<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:drawable/dialog_holo_light_frame"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvThreadTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thread Title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"/>

    <TextView
        android:id="@+id/tvThreadQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Original search query..."
        android:textSize="14sp"
        android:textColor="@color/textColorSecondary"
        android:layout_marginTop="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvThreadMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode: Research"
            android:textSize="12sp"
            android:textStyle="italic"/>

        <TextView
            android:id="@+id/tvThreadDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated: 2024-05-20"
            android:textSize="12sp"
            android:layout_marginStart="16dp"/>

        <TextView
            android:id="@+id/tvThreadCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4 papers"
            android:textSize="12sp"
            android:gravity="end"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"/>
    </LinearLayout>

</LinearLayout>
